# Wolaita Marketplace (Sodo Market Hub) — environment settings
#
# Copy this file twice:
#   .env                  (repo root — used by Prisma: migrations and seed)
#   apps/web/.env.local   (used by the Next.js app)
# Both need the same DATABASE_URL.

# ─── Database (PostgreSQL) ──────────────────────────────────────────
# Your own PostgreSQL:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/wolaita_marketplace?schema=public"
# Or the zero-setup local database started with `npm run db:local`:
# DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable&connection_limit=1"

# ─── Security ───────────────────────────────────────────────────────
# Signs login sessions. REQUIRED in production: a long random string (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# ─── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Shows one-click demo accounts on the sign-in page. Set to "false" in production.
NEXT_PUBLIC_DEMO_MODE="true"

# ─── Uploaded photos ────────────────────────────────────────────────
# Folder for listing photos, relative to apps/web (default: <repo>/uploads).
# In production point this at a persistent disk or volume.
UPLOAD_DIR="../../uploads"
# On Vercel: create a Blob store (Storage tab) and this is set for you.
# When it's set, photos are stored in Vercel Blob instead of UPLOAD_DIR.
# BLOB_READ_WRITE_TOKEN=""

# ─── Branding & language ────────────────────────────────────────────
NEXT_PUBLIC_PLATFORM_NAME="Wolaita Marketplace"
NEXT_PUBLIC_PLATFORM_TAGLINE="Trusted Properties & Vehicles in Wolaita Sodo"
# wal = Wolaytta, am = Amharic, en = English
NEXT_PUBLIC_DEFAULT_LOCALE="wal"
NEXT_PUBLIC_SUPPORT_PHONE="+251900000000"
NEXT_PUBLIC_SUPPORT_EMAIL="contact@wolaitamarketplace.et"
