// Prisma schema for Wolaita Marketplace (Sodo Market Hub)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  BROKER
  AGENCY_ADMIN
  ADMIN
}

enum AssetType {
  REAL_ESTATE
  VEHICLE
}

enum PropertyType {
  HOUSE
  APARTMENT
  RESIDENTIAL_LAND
  COMMERCIAL_LAND
  SHOP
  OFFICE
  WAREHOUSE
  OTHER
}

enum TransactionType {
  FOR_SALE
  FOR_RENT
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum VehicleType {
  CAR
  MOTORCYCLE
  TRUCK
  COMMERCIAL
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  BENZINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum VehicleCondition {
  BRAND_NEW
  EXCELLENT
  GOOD
  FAIR
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
  SOLD
  RENTED
  UNAVAILABLE
  EXPIRED
}

enum LeadStage {
  NEW_INQUIRY
  CONTACT_ATTEMPTED
  CONTACTED
  VIEWING_SCHEDULED
  NEGOTIATION
  WON
  LOST
  FOLLOW_UP_REQUIRED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum DealStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReportReason {
  FRAUD
  DUPLICATE_LISTING
  INCORRECT_PRICE
  UNAVAILABLE_ASSET
  OFFENSIVE_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String         @unique
  passwordHash  String
  role          Role           @default(BUYER)
  isActive      Boolean        @default(true)
  profile       UserProfile?
  listings      Listing[]      @relation("UserListings")
  agencyMembers AgencyMember[]
  assignedLeads Lead[]         @relation("AssignedBrokerLeads")
  appointments  Appointment[]  @relation("BrokerAppointments")
  deals         Deal[]         @relation("BrokerDeals")
  auditLogs     AuditLog[]     @relation("UserAuditLogs")
  buyerLeads    Lead[]         @relation("BuyerLeads")
  favorites     Favorite[]
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([phone])
  @@index([role])
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  bio             String?
  avatarUrl       String?
  businessName    String?
  licenseNumber   String?
  idVerified      Boolean  @default(false)
  preferredLocale String   @default("wal") // 'wal', 'am', or 'en'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Agency {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  logoUrl     String?
  phone       String
  email       String
  address     String?
  isVerified  Boolean        @default(false)
  members     AgencyMember[]
  listings    Listing[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum AgencyRole {
  OWNER
  MANAGER
  AGENT
}

model AgencyMember {
  id        String     @id @default(uuid())
  agencyId  String
  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AgencyRole @default(AGENT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([agencyId, userId])
}

model Location {
  id          String   @id @default(uuid())
  city        String   @default("Wolaita Sodo")
  zone        String   // e.g. Merkato, Arada, Mehal Ketema, Boditi Road, Ligaba, Wadu
  kebele      String?
  landmark    String?
  latitude    Float?
  longitude   Float?
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city, zone])
}

model Asset {
  id               String           @id @default(uuid())
  assetType        AssetType
  locationId       String
  location         Location         @relation(fields: [locationId], references: [id])
  ownerDeclaration String?          // Permission & authorization statement
  propertyDetails  PropertyDetails?
  vehicleDetails   VehicleDetails?
  listings         Listing[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([assetType])
}

model PropertyDetails {
  id                   String           @id @default(uuid())
  assetId              String           @unique
  asset                Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  propertyType         PropertyType
  transactionType      TransactionType  @default(FOR_SALE)
  bedrooms             Int?
  bathrooms            Int?
  areaSqM              Float?
  compoundSizeSqM      Float?
  furnishing           FurnishingStatus @default(UNFURNISHED)
  waterConnected       Boolean          @default(true)
  electricityConnected Boolean          @default(true)
  parkingSpaces        Int?             @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([propertyType, transactionType])
}

model VehicleDetails {
  id           String           @id @default(uuid())
  assetId      String           @unique
  asset        Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vehicleType  VehicleType      @default(CAR)
  make         String           // e.g. Toyota, Hyundai, Isuzu, Lifan
  model        String           // e.g. Vitz, Corolla, Hilux, Tucson
  year         Int
  mileageKm    Int?
  transmission TransmissionType @default(MANUAL)
  fuelType     FuelType         @default(BENZINE)
  condition    VehicleCondition @default(GOOD)
  plateCode    String?          // e.g. Code 3, Code 2 (publicized only as verified flag)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([make, model, year])
  @@index([vehicleType])
}

model Listing {
  id              String         @id @default(uuid())
  assetId         String
  asset           Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  authorId        String
  author          User           @relation("UserListings", fields: [authorId], references: [id])
  agencyId        String?
  agency          Agency?        @relation(fields: [agencyId], references: [id])
  title           String
  slug            String         @unique
  description     String
  price           Decimal        @db.Decimal(14, 2)
  currency        String         @default("ETB")
  isNegotiable    Boolean        @default(true)
  status          ListingStatus  @default(PENDING_REVIEW)
  isFeatured      Boolean        @default(false)
  viewCount       Int            @default(0)
  rejectionReason String?
  moderationNotes String?
  publishedAt     DateTime?
  expiresAt       DateTime?
  media           ListingMedia[]
  leads           Lead[]
  appointments    Appointment[]
  deals           Deal[]
  reports         Report[]
  favorites       Favorite[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([authorId])
  @@index([slug])
  @@index([price])
}

model ListingMedia {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId, order])
}

model Lead {
  id             String        @id @default(uuid())
  listingId      String?
  listing        Listing?      @relation(fields: [listingId], references: [id])
  assignedUserId String?
  assignedUser   User?         @relation("AssignedBrokerLeads", fields: [assignedUserId], references: [id])
  buyerId        String?
  buyer          User?         @relation("BuyerLeads", fields: [buyerId], references: [id])
  customerName   String
  customerPhone  String
  customerEmail  String?
  budgetMin      Decimal?      @db.Decimal(14, 2)
  budgetMax      Decimal?      @db.Decimal(14, 2)
  message        String
  source         String        @default("DIRECT_INQUIRY")
  stage          LeadStage     @default(NEW_INQUIRY)
  notes          String?
  nextFollowUpAt DateTime?
  appointments   Appointment[]
  deals          Deal[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([stage])
  @@index([assignedUserId])
  @@index([buyerId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}

model Appointment {
  id            String            @id @default(uuid())
  leadId        String?
  lead          Lead?             @relation(fields: [leadId], references: [id])
  listingId     String?
  listing       Listing?          @relation(fields: [listingId], references: [id])
  brokerId      String
  broker        User              @relation("BrokerAppointments", fields: [brokerId], references: [id])
  title         String
  scheduledAt   DateTime
  status        AppointmentStatus @default(CONFIRMED)
  locationNotes String?
  outcomeNotes  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([brokerId, scheduledAt])
}

model Deal {
  id                 String     @id @default(uuid())
  listingId          String
  listing            Listing    @relation(fields: [listingId], references: [id])
  leadId             String?
  lead               Lead?      @relation(fields: [leadId], references: [id])
  brokerId           String
  broker             User       @relation("BrokerDeals", fields: [brokerId], references: [id])
  agreedPrice        Decimal    @db.Decimal(14, 2)
  currency           String     @default("ETB")
  commissionExpected Decimal?   @db.Decimal(14, 2)
  commissionPaid     Decimal?   @db.Decimal(14, 2)
  status             DealStatus @default(IN_PROGRESS)
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([brokerId, status])
}

model Report {
  id            String       @id @default(uuid())
  listingId     String
  listing       Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterEmail String
  reporterPhone String?
  reason        ReportReason
  details       String
  status        ReportStatus @default(OPEN)
  adminNotes    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([listingId, status])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation("UserAuditLogs", fields: [actorId], references: [id])
  action       String
  entityType   String
  entityId     String?
  metadataJson String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
